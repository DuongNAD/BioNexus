{
  "name": "bionexus-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cross-env VITE_USE_MOCKS=false vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "lint:emojis": "node scripts/verify-no-emojis.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "node scripts/shots.mjs",
    "photos:fetch": "node scripts/fetch-photos.mjs",
    "photos:build": "node scripts/optimize-photos.mjs",
    "check:preload": "node scripts/verify-no-three-preload.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:emojis && npm run test && npm run build && npm run check:preload && npm run check:budget"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.1.1",
    "@fontsource/cormorant-garamond": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tanstack/react-query": "^5.62.8",
    "@types/three": "^0.187.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.1.18",
    "lucide-react": "^0.469.0",
    "maath": "^0.10.8",
    "motion": "^12.0.0",
    "msw": "^2.7.0",
    "postprocessing": "^6.39.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router": "^7.1.1",
    "react-router-dom": "^7.1.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.187.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "oxlint": "^0.15.6",
    "prettier": "^3.4.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
