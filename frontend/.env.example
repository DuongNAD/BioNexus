# Cấu hình biến môi trường BioNexus Frontend (Mẫu)
# Lưu ý: Các file .env.* cục bộ bị .gitignore gốc bỏ qua, không commit lên git.

# Bật/tắt Mock Service Worker (true = dùng MSW mock, false = gọi backend Tomcat thật)
VITE_USE_MOCKS=true

# Độ trễ mạng giả lập của MSW (milliseconds)
VITE_MOCK_LATENCY=350

# Đường dẫn gốc API (luôn là đường dẫn tương đối)
VITE_API_BASE=api/
